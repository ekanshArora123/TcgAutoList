# Frontend (Vite) environment. Copy to `.env` for local dev (`.env` is gitignored).
#
# Backend origin the dashboard calls. No trailing slash, no /api suffix —
# the app appends /api itself. Exposed to the client bundle at build time, so
# keep it non-secret (it's just a public URL).
#
# Local dev:
API_BASE=http://localhost:5000
#
# Deployed: set this wherever you host the frontend (e.g. Vercel project env)
# to point at the deployed Flask backend, e.g.
# API_BASE=https://api.yourdomain.com
