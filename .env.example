# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_personal_chat_id

# eBay Developer Credentials
EBAY_CLIENT_ID=your_ebay_client_id
EBAY_CLIENT_SECRET=your_ebay_client_secret
EBAY_ENVIRONMENT=sandbox

# TCGplayer (optional — enables full sales history with pagination)
# Get from browser cookies: TCGAuthTicket_Production value after logging in
TCGPLAYER_AUTH_COOKIE=

# PSA graded-card cert lookup ("add graded card by cert number").
# Scrapes the (Cloudflare-protected) PSA website with a real browser.
#
# RECOMMENDED — CDP attach (fast: ~0.5-2s/lookup, reliable). Launch a Chrome once
# with a debug port and point PSA_CDP_URL at it; the code attaches to that running
# Chrome (which Cloudflare trusts) and never closes it or your tabs. Setup:
#   1) Start Chrome:  chrome.exe --remote-debugging-port=9222 --user-data-dir="C:\psa-chrome"
#      (a dedicated profile dir avoids conflicting with your everyday Chrome; keep
#       this window open while using the dashboard).
#   2) Set:
PSA_CDP_URL=
# e.g. PSA_CDP_URL=http://localhost:9222   (or PSA_CDP_PORT=9222)
#
# FALLBACK (no CDP): the code launches its own browser. Slower and Cloudflare
# wedges repeat lookups unless the window holds foreground. Optional knobs:
PSA_USER_DATA_DIR=
# PSA_HEADLESS=1              # force headless (Cloudflare usually blocks it)
# PSA_BROWSER_CHANNEL=chrome  # use installed Chrome instead of bundled Chromium
# See services/card_server/helpers/grading/README.md for details.
# (PSA_API_TOKEN is no longer used — the official API's ~1/day quota was unusable.)

# Database
DB_PATH=./services/card_server/data/cards.db

# Photos
PHOTOS_DIR=./photos

# Frontend (Vite) — dashboard's backend origin. No trailing slash, no /api
# suffix (the app appends /api). Non-secret: only API_/VITE_-prefixed vars are
# baked into the client bundle. Defaults to http://localhost:5000 if unset.
# For deploys, set this in the host build env (Vercel project settings).
API_BASE=http://localhost:5000
