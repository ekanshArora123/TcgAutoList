{
  "name": "tcg-autolist",
  "version": "1.0.0",
  "description": "Agentic Pokemon card eBay listing system using MCP servers",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "tsx src/index.ts start",
    "status": "tsx src/index.ts status",
    "import": "tsx src/index.ts import",
    "server:collection": "tsx src/servers/collection/index.ts",
    "server:cardinfo": "tsx src/servers/cardinfo/index.ts",
    "test": "node --import tsx --test dashboard/backend/orchestrator/__tests__/*.test.ts services/telegram/__tests__/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "better-sqlite3": "^11.8.1",
    "dotenv": "^16.4.7",
    "node-telegram-bot-api": "^0.66.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.10",
    "@types/node-telegram-bot-api": "^0.64.7",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
