{
  "name": "card-server",
  "version": "1.0.0",
  "description": "MCP server for TCG card collection, metadata, and pricing",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "tsx src/index.ts",
    "test": "node --import tsx --test src/**/__tests__/**/*.test.ts",
    "migrate": "tsx src/migrate.ts",
    "collect": "tsx src/collect.ts",
    "collect:stale": "tsx src/collect.ts --stale",
    "collect:cohort": "tsx src/collect.ts --cohort"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "better-sqlite3": "^11.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
